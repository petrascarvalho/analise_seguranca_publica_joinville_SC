# Ambientes e segredos.
.env
.env.*
.venv/
venv/
.streamlit/secrets.toml

# Caches e arquivos gerados pelo ambiente de desenvolvimento.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.cache/
.matplotlib/
fontlist-v*.json
node_modules/

# Temporários, logs e cópias locais; nenhum arquivo é apagado por estas regras.
*.log
*.tmp
*.temp
*.swp
*.swo
~$*
*.bak
*.zip
.DS_Store
Thumbs.db
desktop.ini
*.inspect.ndjson
/backup_pre_migracao_20261016/
/data/joinville_rows.json

# Acervo de dados: lista explícita do que é publicado (ZIPs aprovados, READMEs, manifesto, hashes e inventário).
# Arquivos soltos, PDFs da SSP/SC, edições anteriores dos XLSX e cópias locais continuam só no computador.
/dados/*
!/dados/README.md
!/dados/manifesto_zips.json
!/dados/SHA256SUMS.txt
!/dados/inventario_dados.csv
!/dados/brutos/
/dados/brutos/*
!/dados/brutos/sinesp_20[2-9][0-9]_xlsx.zip
# SSP/SC: README, catálogo de fontes e ZIP dos CSVs extraídos. O ZIP dos PDFs originais fica local (reserva de direitos).
!/dados/brutos/ssp_sc/
/dados/brutos/ssp_sc/*
!/dados/brutos/ssp_sc/README.md
!/dados/brutos/ssp_sc/fontes_oficiais.csv
!/dados/brutos/ssp_sc/ssp_sc_csv_extraidos.zip
!/dados/processados/
/dados/processados/*
!/dados/processados/SINESP_20_26_Petras_Ruben_Carvalho.zip
!/dados/processados/consolidacao_union_joinville.zip
!/dados/processados/ssp_sc/
/dados/processados/ssp_sc/*
!/dados/processados/ssp_sc/ssp_sc_joinville_processados.zip
!/dados/processados/historico/
/dados/processados/historico/*
!/dados/processados/historico/sinesp_edicao_anterior_ate_ago2026.zip
!/dados/processados/historico/ssp_sc_versoes_anteriores.zip
!/dados/processados/complementares/
/dados/processados/complementares/*
!/dados/processados/complementares/fontes_complementares_joinville.zip
# saídas antigas e evidência da SSP/SC: só locais, preservadas em historico/
/historico/saidas_antigas/
/historico/ssp_sc/evidencia_grafia_violencia_domestica_2023.png

# Memória de continuidade externa; proteger também contra cópias acidentais.
README_IA*.md

# Atualização controlada dos dados: entradas oficiais baixadas, candidatas, versões anteriores e relatórios de
# verificação são locais (a versão ativa publicada é dashboard/data_publica/).
/atualizacao/
/dashboard/data_publica.novo/
/dashboard/data_publica.antigo/

# Vídeo de apresentação: só o README é publicado; gravações e versões provisórias ficam locais.
/video/*
!/video/README.md

# Material local de revisão visual (capturas); não faz parte da entrega.
/revisao_visual/
